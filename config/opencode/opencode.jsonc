{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@plannotator/opencode@latest",
    "opencode-kiro"
  ],
  "provider": {
    "kiro": {
      "npm": "kiro-acp-ai-provider",
      "name": "Kiro",
      "models": {
        "auto": {
          "name": "Auto",
          "api": { "id": "auto" },
          "limit": { "context": 200000, "output": 64000 }
        },
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4.0",
          "api": { "id": "claude-sonnet-4" },
          "limit": { "context": 200000, "output": 64000 }
        },
        "claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5",
